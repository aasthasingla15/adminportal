# ================================================
# MSC Events Portal — Environment Variables
# ================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# MongoDB connection URI — required
# For local dev: mongodb://127.0.0.1:27017/msc_events
# For production (MongoDB Atlas): mongodb+srv://user:password@cluster.mongodb.net/msc_events
MONGODB_URI=

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: Cloudinary image hosting
# If not set, images are stored as base64 strings in MongoDB
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
